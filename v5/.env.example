DATABASE_URL=postgres://lnt:lnt@localhost:5432/lnt

# To run a second checkout's dev stack beside this one, give it a database and ports of its own.
# In that checkout's .env, replace the DATABASE_URL line above with the first of these, and add the
# other two:
#   DATABASE_URL=postgres://lnt:lnt@localhost:5432/lnt_other
#   DEV_SERVER_PORT=3001
#   DEV_CLIENT_PORT=5174
# Then create its database once, with
#   docker compose exec postgres createdb -U lnt lnt_other && npm run db:migrate
# Both checkouts use the same Postgres (Compose project `v5`): `npm run db:down` in either one
# stops it for both.
