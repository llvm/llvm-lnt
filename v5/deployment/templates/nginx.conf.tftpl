server {
    listen 80;
    server_name ${domain};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${domain};

    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    # Run submissions can be large: bump the default limit. Keep this in sync with the app's
    # BODY_LIMIT in config.py.
    client_max_body_size 128m;

    # Look the app up through Docker's DNS on each request, rather than once when Nginx starts: the
    # app's container can get another address when it restarts, for example to retry a migration
    # that failed. Proxying to a variable is what makes Nginx use the resolver.
    resolver 127.0.0.11 valid=10s;

    location / {
        set $app http://app:3000;
        proxy_pass $app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
