services:
  app:
    image: ${image}
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - ./certs/rds-global-bundle.pem:/app/certs/rds-global-bundle.pem:ro
    expose:
      - "3000"

  nginx:
    image: nginx:1.30-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certs/origin.pem:/etc/nginx/certs/origin.pem:ro
      - ./certs/origin.key:/etc/nginx/certs/origin.key:ro
    # Start without waiting for the app to become healthy: Nginx answers 502 until the app has
    # migrated the database and serves, then serves too. Waiting on the app's healthcheck would put a
    # deadline on migrations, which take longer as the data grows.
    depends_on:
      app:
        condition: service_started
